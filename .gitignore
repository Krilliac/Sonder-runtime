# Generated by the C# verification project used by the arena-shooter example.
# Keep an ordinary local example build from making an installed source checkout
# look modified to the guarded runtime updater.
examples/codegen-arena-shooter/Verify/bin/
examples/codegen-arena-shooter/Verify/obj/
examples/codegen-arena-shooter/FpsGame_Skeleton/

# The runtime virtualenv moved from venv/ to .runtime/ but this file did not
# follow it, leaving 83 MB of installed packages untracked-and-unignored where
# a single `git add -A` would commit them.
.runtime/
# Claude Code session state, including git worktrees checked out beneath the
# repo. A worktree is a second copy of this repo, so leaving it visible also
# made repo-wide source scans report the copy's files as offenders.
.claude/
.pytest_cache/
# Codex/pytest bounded-run output directories; keep repository status usable
# when many isolated suites run concurrently.
/.pytest-*/
/.pytest-*.txt
/pytest-cache-*/
/probe-*/
/tmp/pytest-cache-*/
# eval_harness run artifacts: traces hold raw prompts/model responses and are
# local diagnostic output, never source. The checked-in fixtures live in
# eval_scenarios/ instead.
/eval_runs/
