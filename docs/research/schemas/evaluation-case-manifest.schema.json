{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonder-runtime.local/schemas/evaluation-case-manifest.schema.json",
  "title": "Sonder Runtime evaluation case manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite", "cases"],
  "properties": {
    "schema": {"const": "sonder.evaluation-case-manifest.v1"},
    "suite": {"$ref": "#/$defs/suite"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/case"}
    },
    "manifest_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "suite_id", "version", "dimensions", "metric_names", "suite_digest"],
      "properties": {
        "schema": {"const": "sonder.evaluation-proposal-lifecycle.v1"},
        "suite_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/dimension"}
        },
        "metric_names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "suite_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "revision"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "artifact_digest": {
          "oneOf": [
            {"const": ""},
            {"$ref": "#/$defs/sha256"}
          ]
        }
      }
    },
    "grader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier", "spec", "advisory"],
      "properties": {
        "verifier": {"$ref": "#/$defs/identifier"},
        "spec": {"type": "object"},
        "advisory": {"type": "boolean"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "input", "target", "grader", "provenance"],
      "properties": {
        "case_id": {"$ref": "#/$defs/identifier"},
        "input": {},
        "target": {},
        "grader": {"$ref": "#/$defs/grader"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "case_digest": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "grader": {
                "properties": {"verifier": {"const": "llm_judge"}},
                "required": ["verifier"]
              }
            }
          },
          "then": {
            "properties": {
              "grader": {
                "properties": {"advisory": {"const": true}},
                "required": ["advisory"]
              }
            }
          }
        }
      ]
    }
  }
}
