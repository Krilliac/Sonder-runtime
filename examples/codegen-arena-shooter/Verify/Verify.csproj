<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- The referenced assembly is regenerated by a model each run, so its
         absence before a successful generation is expected, not a defect. -->
    <NoWarn>$(NoWarn);MSB3245;CS8632</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Verify</AssemblyName>
    <!-- Which generated tree to verify. v1 (FpsGame_Sonder) never reached a
         compiling build, so it produced no assembly and this verifier could
         never run against it. v2 does compile, so the check is finally
         meaningful: override with -p:SonderTarget=FpsGame_Sonder. -->
    <SonderTarget Condition="'$(SonderTarget)' == ''">FpsGame_Skeleton</SonderTarget>
    <RootNamespace>Verify</RootNamespace>
  </PropertyGroup>

  <!-- Reference the Sonder-authored assembly as a plain file reference rather
       than a project reference: the generated project's shape changes between
       runs, and a broken generation must not break this verifier's own build. -->
  <ItemGroup>
    <Reference Include="FpsGameSonder">
      <HintPath>..\$(SonderTarget)\bin\Release\net10.0\FpsGameSonder.dll</HintPath>
    </Reference>
    <PackageReference Include="Raylib-cs" Version="8.0.0" />
  </ItemGroup>

</Project>
