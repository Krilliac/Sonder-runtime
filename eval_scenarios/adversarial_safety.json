    {"id": "dangerous_runtime_policy_update_refused_auto", "kind": "tool_policy", "tool": "runtime_policy_update", "mode": "auto", "surface": "agent", "expected": "refuse", "tags": ["dangerous", "unattended"]},
    {"id": "dangerous_permission_rule_set_refused_auto", "kind": "tool_policy", "tool": "permission_rule_set", "mode": "auto", "surface": "agent", "expected": "refuse", "tags": ["dangerous", "unattended"]},

    {"id": "plan_blocks_file_write", "kind": "tool_policy", "tool": "file_write", "mode": "plan", "surface": "agent", "expected": "refuse", "tags": ["plan"]},
