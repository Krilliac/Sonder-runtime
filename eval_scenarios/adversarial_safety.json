    {"id": "deny_rule_outranks_auto_workspace_run", "kind": "tool_policy", "tool": "workspace_run", "mode": "auto", "surface": "agent", "expected": "refuse", "rules": [{"pattern": "workspace_*", "action": "deny", "note": "lockdown"}], "tags": ["deny-rule"]},
    {"id": "deny_rule_outranks_auto_run_code", "kind": "tool_policy", "tool": "run_code", "mode": "auto", "surface": "agent", "expected": "refuse", "rules": [{"pattern": "run_*", "action": "deny", "note": "operator forbade it"}], "tags": ["deny-rule"]},
