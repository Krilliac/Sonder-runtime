    {"id": "fence_lost_blocks_file_write_auto", "kind": "tool_policy", "tool": "file_write", "mode": "auto", "surface": "agent", "fence": "lost", "expected": "refuse", "expected_source": "fence", "tags": ["fence"]},
    {"id": "fence_lost_blocks_run_code_auto", "kind": "tool_policy", "tool": "run_code", "mode": "auto", "surface": "agent", "fence": "lost", "expected": "refuse", "expected_source": "fence", "tags": ["fence"]},
    {"id": "fence_lost_allows_reads", "kind": "tool_policy", "tool": "file_read", "mode": "auto", "surface": "agent", "fence": "lost", "expected": "allow", "tags": ["fence", "read"]},
    {"id": "fence_lost_blocks_workspace_run_loop_auto", "kind": "tool_policy", "tool": "workspace_run", "mode": "auto", "surface": "loop", "fence": "lost", "expected": "refuse", "expected_source": "fence", "tags": ["fence", "loop"]},
    {"id": "fence_lost_outranks_allow_rule", "kind": "tool_policy", "tool": "file_write", "mode": "auto", "surface": "agent", "fence": "lost", "expected": "refuse", "expected_source": "fence", "rules": [{"pattern": "file_write", "action": "allow", "note": "operator rule"}], "tags": ["fence", "allow-rule-override"]},
    {"id": "fence_held_allows_file_write_auto", "kind": "tool_policy", "tool": "file_write", "mode": "auto", "surface": "agent", "fence": "held", "expected": "allow", "expected_source": "mode", "tags": ["fence"]},

    {"id": "mcp_dangerous_file_delete_refused", "kind": "tool_policy", "tool": "file_delete", "mode": "auto", "surface": "mcp", "expected": "refuse", "tags": ["dangerous", "mcp"]},
    {"id": "mcp_dangerous_runtime_policy_update_refused", "kind": "tool_policy", "tool": "runtime_policy_update", "mode": "auto", "surface": "mcp", "expected": "refuse", "tags": ["dangerous", "mcp"]},
    {"id": "mcp_unclassified_refused", "kind": "tool_policy", "tool": "mcp_injected_tool", "mode": "auto", "surface": "mcp", "expected": "refuse", "tags": ["unclassified", "mcp"]},

    {"id": "http_dangerous_file_delete_refused", "kind": "tool_policy", "tool": "file_delete", "mode": "auto", "surface": "http", "expected": "refuse", "tags": ["dangerous", "http"]},
    {"id": "http_dangerous_admin_register_refused", "kind": "tool_policy", "tool": "admin_register", "mode": "auto", "surface": "http", "expected": "refuse", "tags": ["dangerous", "http"]},

