# Sonder Runtime as a Codex MCP server.
#
# Append to ~/.codex/config.toml and replace <SONDER_DIR> with the absolute
# path to your checkout. On Windows the interpreter is
# <SONDER_DIR>\venv\Scripts\python.exe; on Linux/macOS it is
# <SONDER_DIR>/venv/bin/python. Use the venv interpreter, not a system python.

[mcp_servers.sonder]
command = '<SONDER_DIR>/venv/bin/python'
args = ['<SONDER_DIR>/server.py']
# First start may pull an embedding model, so allow generous startup.
startup_timeout_sec = 120.0

[mcp_servers.sonder.env]
# --- tier -> model. setup_alias.py creates this hardware-sized stable alias. ---
SONDER_FAST = "sonder:latest"
SONDER_CODE = "sonder:latest"
SONDER_GENERAL = "sonder:latest"
# Optional specialist tiers stay unbound until you configure installed models.
# SONDER_REASONING = "<installed reasoning model>"
# SONDER_VISION = "<installed vision model>"

# --- serving ---
# Leave placement unset for Ollama's CPU/Metal/AMD/Intel/NVIDIA capability
# detection. Pin only after measuring this host; 0 explicitly means CPU-only.
# SONDER_NUM_GPU = "0"
# Sonder detects logical CPU count; optionally cap it for a shared machine.
# SONDER_NUM_THREAD = "8"
SONDER_NUM_BATCH = "512"
# Longer keeps models resident between turns; shorten it if RAM is tight.
SONDER_KEEP_ALIVE = "5m"

# --- learning loop ---
# Tiers whose interactions are captured and can distil into lessons.
SONDER_LEARN_TIERS = "fast,code,general"

# --- cloud tiers: OFF unless you opt in ---
# Uncommenting these sends prompts off your machine and is metered. Leave
# them commented to keep everything local.
# SONDER_ALLOW_CLOUD = "1"
# SONDER_CLOUD_CODE = "<a cloud model you have configured>"
# SONDER_CLOUD_GENERAL = "<a cloud model you have configured>"
