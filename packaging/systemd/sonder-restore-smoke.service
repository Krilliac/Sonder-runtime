# Weekly automated restore smoke test (SPEC-2 WP7).
# Restores the newest dated backup into a disposable directory and verifies
# integrity, foreign keys, and schema-ledger health. `backup latest` prints
# the newest backup whose manifest has a parseable created_at_utc and exits 1
# (failing the run through `set -e`) when there is none. The selection lives
# in the CLI so this line needs no nested shell/systemd quoting. A newest
# backup that no longer verifies fails the smoke on purpose: that is the
# regression to surface.

[Unit]
Description=Sonder backup restore smoke test
After=sonder.service

[Service]
Type=oneshot
User=sonder
Group=sonder
WorkingDirectory=/opt/sonder/current
EnvironmentFile=/etc/sonder/sonder.env
ExecStart=/bin/sh -c 'set -e; \
  latest=$(/opt/sonder/current/venv/bin/python -m sonder_runtime backup latest \
    --config /etc/sonder/sonder.toml); \
  /opt/sonder/current/venv/bin/python -m sonder_runtime restore smoke "$latest"'
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sonder /var/backups/sonder
