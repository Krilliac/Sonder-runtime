# Daily backup with tiered retention (SPEC-2 WP7).

[Unit]
Description=Sonder backup
After=sonder.service

[Service]
Type=oneshot
User=sonder
Group=sonder
WorkingDirectory=/opt/sonder/current
EnvironmentFile=/etc/sonder/sonder.env
ExecStart=/opt/sonder/current/venv/bin/python -m sonder_runtime backup create --config /etc/sonder/sonder.toml
ExecStartPost=/opt/sonder/current/venv/bin/python -m sonder_runtime backup prune --config /etc/sonder/sonder.toml
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sonder /var/backups/sonder
