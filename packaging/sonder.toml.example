# Sonder runtime production configuration (SPEC-2 section 3).
# Install to /etc/sonder/sonder.toml. Secrets never go in this file —
# they belong in /etc/sonder/sonder.env (mode 0600).

schema_version = 1
profile = "server-private"

[server]
host = "127.0.0.1"
port = 11435
auth_mode = "api-key"
max_request_bytes = 1048576
max_concurrent_requests = 4
request_timeout_seconds = 300
stream_idle_timeout_seconds = 60
cors_origins = []
require_account = false
allow_registration = false
reasoning_audience = "developer"
session_state_limit = 128
session_state_owner_limit = 32
train_max_n = 500
trusted_proxy_cidrs = ["127.0.0.1/32", "::1/128"]
# The packaged reverse-proxy topology terminates TLS before this loopback
# listener. Keep this true there: it also disables the unauthenticated local
# log dashboard, which a proxy must never publish to remote clients.
tls_terminated_by_proxy = true

[state]
home = "/var/lib/sonder"
workspace_roots = ["/srv/sonder/workspaces"]
minimum_free_disk_bytes = 5368709120
sqlite_busy_timeout_ms = 5000

[ollama]
url = "http://127.0.0.1:11434"
allow_remote = false
# workers = ["http://10.0.0.2:11434"]
# Private-network CIDRs where HTTP (non-TLS) Ollama workers are accepted.
# Without this, remote workers must use HTTPS.  Use only on isolated LANs.
# trusted_origins = ["10.0.0.0/8", "192.168.0.0/16"]
startup_timeout_seconds = 60
request_timeout_seconds = 300

[deployment]
# Pooling computes on another PC; it does not replicate control state or elect owners.
profile = "single-host" # or "pooled-pair" with exactly one configured compute peer
preferred_primary = "" # optional configured member; preference grants no authority
# True is rejected until independent fencing, acknowledged replication and epochs exist.
automatic_takeover = false
automatic_failback = false

[compute]
# Private-node compute is a separate consent lane from remote Ollama and cloud.
# See docs/runbooks/compute-fabric.md before adding [[compute.nodes]] or
# worker-owned [[compute.jobs]]. Every remote workload must also opt in.
allow_remote = false
node_id = "local"
# One physical host authority per jobs.db. Keep this stable across worker restarts.
worker_host_id = "local"
# Omitted RAM budget: fresh local available RAM, exclusive one-job admission.
# A positive budget enables configured accounting; 0 explicitly disables dispatch.
# worker_memory_budget_bytes = 4294967296
worker_max_jobs = 1
worker_reservation_seconds = 30
snapshot_ttl_seconds = 30
probe_timeout_ms = 2000

[features]
cloud = false
web = false
live_reload = false
source_modification = false
host_control = false
training = false
npu = false
expose_reasoning = false
allow_private_cot = false
location_consent = false

[capacity]
model_generations = 1
http_requests = 4
tool_processes = 2
fleet_workers = 2
autopilot_runs = 1
training_jobs = 1
queue_depth = 32

[observability]
log_format = "json"
log_level = "INFO"
metrics_enabled = true
metrics_path = "/metrics"
audit_retention_days = 90

[backup]
enabled = true
target = "/var/backups/sonder"
retention_daily = 7
retention_weekly = 4
retention_monthly = 6
