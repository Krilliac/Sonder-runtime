# Sonder runtime secrets file (SPEC-2 section 3).
# Install to /etc/sonder/sonder.env, owner root or the service user,
# mode 0600. The configuration loader refuses a group/world-readable
# secrets file.
#
# Generate a strong key, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"

SONDER_API_KEY=
SONDER_AUTH_SECRET=
# Optional only with an enabled [memory_replication] TOML section. The peer
# bearer is sent only to fixed configured receivers. It must differ from the
# API, artifact-transfer, and auth secrets; no overlap/automatic rotation is
# supported.
SONDER_MEMORY_REPLICATION_KEY=
# Local-only checkpoint/anchor integrity key. It must differ from every other
# secret above, including SONDER_MEMORY_REPLICATION_KEY, and is never sent to a
# peer.
SONDER_MEMORY_REPLICATION_STATE_INTEGRITY_KEY=
# Optional independent private-node compute consent override. Configured remote
# nodes still require HTTPS, the API key above, and per-workload consent.
#SONDER_ALLOW_REMOTE_COMPUTE=0
# Backups are not encrypted or key-authenticated. Keep /var/backups/sonder
# private (mode 0700) or on an encrypted volume. SONDER_BACKUP_KEY_FILE is
# not a supported setting: a non-empty value fails configuration.
