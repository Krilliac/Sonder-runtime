# Sonder runtime secrets file (SPEC-2 section 3).
# Install to /etc/sonder/sonder.env, mode 0600. The configuration loader
# refuses a group/world-readable secrets file and must be able to read it:
# systemd (root) reads it for the service, but `--secrets` on a command run as
# the sonder user needs the file owned by sonder (chown sonder:sonder, keep 0600).
#
# Generate a strong key, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"

SONDER_API_KEY=
SONDER_AUTH_SECRET=
# Optional one-shot first-admin bootstrap secret (at least 16 characters). It
# is read from the process environment, not from the secrets file by the
# configuration loader: it works here only because the systemd units load this
# file with EnvironmentFile=. `serve --secrets` alone does not export it.
#SONDER_BOOTSTRAP_SECRET=
# Provider-binding variables (SONDER_MODEL_BACKEND, SONDER_FAST_PROVIDER,
# SONDER_GENERAL_PROVIDER, SONDER_CODE_PROVIDER, SONDER_REASONING_PROVIDER,
# SONDER_VISION_PROVIDER, SONDER_EMBEDDING_PROVIDER, SONDER_INFERENCE_FALLBACK)
# are likewise read from the process environment, so set them here (loaded by
# EnvironmentFile=) rather than in sonder.toml.
# Optional only with an enabled [memory_replication] TOML section. The peer
# bearer is sent only to fixed configured receivers. It must differ from the
# API, artifact-transfer, and auth secrets; no overlap/automatic rotation is
# supported.
SONDER_MEMORY_REPLICATION_KEY=
# Local-only checkpoint/anchor integrity key. It must differ from every other
# secret above, including SONDER_MEMORY_REPLICATION_KEY, and is never sent to a
# peer.
SONDER_MEMORY_REPLICATION_STATE_INTEGRITY_KEY=
# Optional independent private-node compute consent override. Configured remote
# nodes still require HTTPS, the API key above, and per-workload consent.
#SONDER_ALLOW_REMOTE_COMPUTE=0
# Backups are not encrypted or key-authenticated. Keep /var/backups/sonder
# private (mode 0700) or on an encrypted volume. SONDER_BACKUP_KEY_FILE is
# not a supported setting: a non-empty value fails configuration.
