# Sonder runtime secrets file (SPEC-2 section 3).
# Install to /etc/sonder/sonder.env, owner root or the service user,
# mode 0600. The configuration loader refuses a group/world-readable
# secrets file.
#
# Generate a strong key, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"

SONDER_API_KEY=
SONDER_AUTH_SECRET=
# Optional: path to the backup encryption key file.
#SONDER_BACKUP_KEY_FILE=/etc/sonder/backup.key
